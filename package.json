{
  "name": "toad-scheduler",
  "version": "4.2.0",
  "license": "MIT",
  "description": "In-memory Node.js and browser job scheduler",
  "maintainers": [
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com"
    }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"lib/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"{lib,test}/**/*.{js,ts}\" index.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.10.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.6",
    "typescript": "5.2.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/kibertoad/toad-scheduler",
  "repository": {
    "type": "git",
    "url": "git://github.com/kibertoad/toad-scheduler.git"
  },
  "keywords": [
    "schedule",
    "scheduler",
    "in-memory",
    "browser",
    "job",
    "task"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "dist/*"
  ]
}
