{
  "name": "toad-scheduler",
  "version": "4.1.0",
  "license": "MIT",
  "description": "In-memory Node.js and browser job scheduler",
  "maintainers": [
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com"
    }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsc",
    "test": "jest --config=jest.config.json",
    "test:coverage": "jest --config=jest.config.json --coverage",
    "test:karma": "karma start --single-run --browsers ChromeHeadless karma.conf.js",
    "lint": "eslint \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"lib/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"{lib,test}/**/*.{js,ts}\" index.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "eslint": "^10.10.0",
    "jasmine-core": "^7.0.2",
    "jest": "^30.5.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-typescript": "^5.5.4",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "5.2.2",
    "typescript-eslint": "^8.69.0"
  },
  "homepage": "https://github.com/kibertoad/toad-scheduler",
  "repository": {
    "type": "git",
    "url": "git://github.com/kibertoad/toad-scheduler.git"
  },
  "keywords": [
    "schedule",
    "scheduler",
    "in-memory",
    "browser",
    "job",
    "task"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "dist/*"
  ]
}
